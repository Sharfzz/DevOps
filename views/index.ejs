<div class="dash-card" style="margin-top: 16px;">
  <h2 class="dash-card-header" style="font-size: 1rem;">📢 Campus Events</h2>
  
  <div id="events-container" style="padding-top: 6px;">
    <p style="font-size: 0.8rem; color: #888; margin: 0;">Loading events...</p>
  </div>
</div>

<!-- Hidden Event Details Modal Popup -->
<div id="event-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center;">
  <div style="background: #ffffff; border-radius: 12px; padding: 20px; max-width: 400px; width: 85%; position: relative; box-shadow: 0 4px 20px rgba(0,0,0,0.15);">
    <span onclick="closeEventModal()" style="position: absolute; top: 10px; right: 14px; cursor: pointer; font-size: 1.1rem; color: #888;">✕</span>
    <h3 id="modal-title" style="margin-top: 0; color: #1a1a1a; font-size: 1.1rem;"></h3>
    <p id="modal-organizer" style="font-size: 0.75rem; color: #666; margin-top: -6px; margin-bottom: 10px; font-weight: 500;"></p>
    <div style="background: #f8f9fa; padding: 10px; border-radius: 6px; margin-bottom: 10px; font-size: 0.8rem; color: #444;">
      <p style="margin: 0 0 4px 0;">📍 <strong>Location:</strong> <span id="modal-location"></span></p>
      <p style="margin: 0;">🗓️ <strong>Date:</strong> <span id="modal-date"></span></p>
    </div>
    <p id="modal-description" style="font-size: 0.85rem; color: #333; line-height: 1.4; margin-bottom: 0;"></p>
  </div>
</div>

<script>
  let loadedEvents = [];

  document.addEventListener("DOMContentLoaded", () => {
    fetch('/events/api/list')
      .then(res => res.json())
      .then(events => {
        loadedEvents = events;
        const container = document.getElementById('events-container');
        
        if (!events || events.length === 0) {
          container.innerHTML = '<p style="font-size: 0.8rem; color: #888; margin: 0;">No upcoming events.</p>';
          return;
        }

        container.innerHTML = events.map((event, index) => `
          <div onclick="openEventModal(${index})" style="margin-bottom: 8px; padding: 8px 10px; border-radius: 6px; border: 1px solid #f0f0f0; cursor: pointer; background: #fff;" onmouseover="this.style.background='#f8f9fa'" onmouseout="this.style.background='#fff'">
            <div style="font-weight: 600; font-size: 0.85rem; color: #2c3e50; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${event.title}</div>
            <div style="font-size: 0.75rem; color: #888; margin-top: 2px;">📍 ${event.location || 'TBA'} • 👆 Details</div>
          </div>
        `).join('');
      })
      .catch(() => {
        document.getElementById('events-container').innerHTML = '<p style="font-size: 0.8rem; color: #888; margin: 0;">No upcoming events.</p>';
      });
  });

  function openEventModal(index) {
    const event = loadedEvents[index];
    if (!event) return;

    document.getElementById('modal-title').innerText = event.title;
    document.getElementById('modal-organizer').innerText = event.organizer ? `Organized by ${event.organizer}` : '';
    document.getElementById('modal-location').innerText = event.location || 'TBA';
    document.getElementById('modal-date').innerText = event.date ? new Date(event.date).toLocaleDateString() : 'TBA';
    document.getElementById('modal-description').innerText = event.description || 'No description available.';

    document.getElementById('event-modal').style.display = 'flex';
  }

  function closeEventModal() {
    document.getElementById('event-modal').style.display = 'none';
  }

  window.onclick = function(event) {
    const modal = document.getElementById('event-modal');
    if (event.target === modal) modal.style.display = 'none';
  }
</script>
